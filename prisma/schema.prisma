generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DEALER
  USER
}

enum VehicleStatus {
  ON_SALE
  SOLD
}

enum Condition {
  NEW
  USED
}

enum BodyType {
  SUV
  SEDAN
  COUPE
  HATCHBACK
  CONVERTIBLE
  PICKUP
  VAN
  WAGON
}

enum Transmission {
  AUTO
  MANUAL
}

enum FuelType {
  GAS
  ELECTRIC
  DIESEL
  HYBRID
}

/// Regional specification a car was built for. One of the strongest trust
/// signals in the Jordanian market, and previously only expressed as free
/// text inside the description, where it could not be filtered or badged.
enum SpecOrigin {
  GCC
  US
  EU
  KOREAN
  JAPANESE
  OTHER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          Role      @default(USER)
  isSuspended   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  dealership    Dealership?
  vehicles      Vehicle[]
  savedVehicles SavedVehicle[]
}

model Dealership {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  logoUrl         String?
  address         String?
  phone           String?
  whatsappNumber  String?
  website         String?
  userId          String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
}

model Vehicle {
  id               String        @id @default(cuid())
  userId           String
  dealershipId     String?
  status           VehicleStatus @default(ON_SALE)

  videoUrl         String?
  imageUrls        String[]
  instagramVideoUrl String?

  specificWhatsapp String?

  brand            String
  model            String
  price            Int
  shortDescription String        @db.Text

  condition        Condition
  bodyType         BodyType
  transmission     Transmission
  engineCapacityCC Int
  fuelType         FuelType
  mileageKm        Int
  productionYear   Int

  fa7s             String?       @db.Text
  waredWakaleh     Boolean       @default(false)
  specOrigin       SpecOrigin?
  isPromoted       Boolean       @default(false)

  detailedSpecs    Json          @default("[]")

  publicationDate  DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  /// Generated full-text search column. Postgres maintains it; the migration
  /// defines the expression (brand and model weighted above description).
  /// Prisma has no representation for GENERATED ALWAYS columns, so it is
  /// declared Unsupported and never written to from application code.
  searchVector     Unsupported("tsvector")?

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealership  Dealership?    @relation(fields: [dealershipId], references: [id], onDelete: SetNull)
  savedBy     SavedVehicle[]

  // Composite indexes matching the queries the marketplace actually runs.
  // Every listing query filters on status and orders by publicationDate;
  // there was previously no index on publicationDate at all, and ten
  // single-column indexes that no listing query could use.
  @@index([status, publicationDate(sort: Desc)])
  @@index([status, brand, publicationDate(sort: Desc)])
  @@index([status, price])
  @@index([status, productionYear(sort: Desc)])
  @@index([status, mileageKm])
  @@index([status, bodyType, publicationDate(sort: Desc)])
  @@index([status, isPromoted, publicationDate(sort: Desc)])
  // Ownership and relation lookups.
  @@index([dealershipId])
  @@index([userId])
  @@index([searchVector], type: Gin)
}

model SavedVehicle {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
}
