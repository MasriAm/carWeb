# ─── DATABASE ────────────────────────────────────────────────────
# In production point this at a connection pooler (PgBouncer, Neon, Supabase
# pooler). Each serverless instance opens its own pool — see DATABASE_POOL_MAX.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/royal_cars?schema=public"
# Migrations only. Set this when DATABASE_URL points at a pooler: Prisma
# Migrate needs session state that transaction-mode pooling drops. On Neon it
# is the same string with "-pooler" removed from the host. Leave unset locally.
# DIRECT_DATABASE_URL=""
# Max connections per instance pool. Default 5. Raise only on a long-lived server.
# DATABASE_POOL_MAX="5"

# ─── AUTH.JS ─────────────────────────────────────────────────────
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─── AUTH PROVIDERS (optional) ───────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ─── MEDIA STORAGE ──────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── NEXT PUBLIC ─────────────────────────────────────────────────
# Absolute origin. Used for canonical URLs, sitemap.xml and Open Graph images.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── SITE CONTACT (all optional) ─────────────────────────────────
# Anything left blank is simply not rendered. Never ship a placeholder number.
# WhatsApp: digits only, no "+" and no spaces (e.g. 962791234567).
NEXT_PUBLIC_CONTACT_WHATSAPP=""
NEXT_PUBLIC_CONTACT_INSTAGRAM=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_ADDRESS=""

# ─── UPSTASH (rate limiting) ────────────────────────────────────
# Without these the limiter is a no-op (fails open) — set them in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
